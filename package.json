{
  "name": "dsh-workbench-source",
  "version": "0.2.0-rc.1",
  "private": true,
  "description": "Source workspace for DSH Workbench and its optional pane-panel compatibility adapter",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "audit": "pnpm audit --audit-level=low",
    "contract:check": "node scripts/release-contract-check.mjs",
    "secrets:check": "node scripts/scan-secrets.mjs",
    "bundle": "node scripts/build-release-bundle.mjs",
    "release:check": "node scripts/release-check.mjs",
    "install:contract:test": "node --test scripts/install/result.test.mjs"
  },
  "license": "MIT"
}
