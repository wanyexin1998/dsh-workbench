{
  "schemaVersion": 3,
  "releaseStatus": "source-preview",
  "workbenchVersion": "0.2.0-rc.1",
  "presentationProtocol": 2,
  "maxVisiblePanes": 2,
  "thirdSessionDisposition": "replace-focused",
  "repository": {
    "url": "https://github.com/wanyexin1998/dsh-workbench",
    "visibility": "public",
    "githubActions": false
  },
  "sourceVerification": {
    "mode": "user-approved-full-commit",
    "commitFormat": "^[0-9a-fA-F]{40}$",
    "requireNonexistentTarget": true,
    "cloneNoCheckout": true,
    "detachedCheckout": true,
    "failOnGitError": true,
    "detachedHeadProof": true,
    "cleanWorktreeBeforeRepositoryCode": true,
    "exactHeadEqualityBeforeRepositoryCode": true,
    "externalPinnedSourcesBeforeExecution": true,
    "failClosedWorkingDirectory": true,
    "wholeDocumentExecutableScan": true,
    "instructionOrderAnchors": true,
    "signedReleaseAvailable": false
  },
  "harness": {
    "upstreamVersion": "0.1.1-rc.2",
    "upstreamCommit": "b150a551b8d465e31e418e1b2eaf5e79bbb7d28e",
    "repository": "https://github.com/wanyexin1998/deepseek-harness",
    "branch": "codex/presentation-v2",
    "implementationCommit": "53015a6f39710dac52ed08f05aca0c6bad7444ac",
    "distribution": "source-only"
  },
  "chatPreset": {
    "presetId": "chat",
    "seeding": "create-only-with-marker",
    "respectsUserDeletion": true
  },
  "panelCompatibility": {
    "packageVersion": "0.1.0-rc.1",
    "provider": "dsh-better-sidebar",
    "providerVersion": "0.16.1",
    "paneProtocol": 1,
    "actionsProtocol": 1,
    "repository": "https://github.com/wanyexin1998/DSH-better-sidebar",
    "branch": "feat/workbench-actions-consumer",
    "implementationCommit": "168577078bf63a16cb514e879669298565991b07",
    "distribution": "optional-source-only"
  },
  "distribution": {
    "npmPublished": false,
    "automaticInstaller": false,
    "automaticThirdPartyInstall": false,
    "bundledThirdPartyNotices": {
      "@wanyexin1998/dsh-workbench": {
        "path": "packages/dsh-workbench/THIRD_PARTY_NOTICES.md",
        "components": {
          "@deepseek-ai/schemastery": "3.18.1",
          "@deepseek-ai/cosmokit": "1.8.2"
        }
      }
    },
    "artifacts": [
      "@wanyexin1998/dsh-workbench",
      "@wanyexin1998/dsh-workbench-panel-compat"
    ]
  }
}
